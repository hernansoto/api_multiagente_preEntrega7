# Nunca subir .env real ni las API keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM=multiagent:jobs
REDIS_GROUP=multiagent-workers
WORKER_CONCURRENCY=5
# Usar un token privado aleatorio. Necesario para aprobar o rechazar.
APPROVAL_API_KEY=
# Opcional: si queda vacío, los endpoints de tareas son públicos en localhost.
API_KEY=
# LangSmith: dashboard de trazas, costos/token y latencia p95.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=coderhouse-preentrega-7
# LANGSMITH_WORKSPACE_ID= # Solo para keys que lo requieren.
# TAVILY_API_KEY= # Opcional; búsqueda simulada no requiere esta key.
